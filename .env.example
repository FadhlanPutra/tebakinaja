VITE_GOOGLE_MAPS_API_KEY=

# Isi VITE_GEMINI_API_KEY kalau tidak ada server backend. Isi VITE_BACKEND_URL kalau ada server backend
# Disarankan menggunakan server backend untuk handle request & response model gemini
# Hanya isi salah satu. Mengisi keduanya akan mengabaikan VITE_BACKEND_URL
VITE_GEMINI_API_KEY=
VITE_BACKEND_URL=
# Isi jika didalam backend memerlukan token
VITE_APP_SECRET_TOKEN=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# CONFIG
VITE_OAUTH_PROVIDER="google"   # 'firebase' untuk menggunakan oauth dari firebase, 'google' untuk menggunakan oauth dari google cloud console
VITE_LEADERBOARD_MODE=unique      # 'unique' = 1 akun 1 entry, 'all' = semua entry masuk
VITE_PLACE_WEIGHT_MODE=per_user   # 'per_user' = weight per user, 'global' = weight global

# Kalau tidak menggunakan Oauth dari Firebase, pakai google cloud console lalu isi environment variable VITE_GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=